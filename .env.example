# Reference for every environment key. The processes load server/.env and client/.env.local.
# Copy to client/.env.local.
# Browser calls stay same-origin; Next.js forwards /api to Express.
NEXT_PUBLIC_API_BASE_URL=/api
# Private server-side value. Do not prefix with NEXT_PUBLIC.
API_PROXY_TARGET=http://localhost:4000

# Copy to server/.env. Never put server secrets in the client environment.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Neon pooled URL for the API; replace host, role, password and database.
DATABASE_URL=postgresql://ROLE:PASSWORD@NEON_POOLED_HOST/DATABASE?sslmode=verify-full
# Neon direct (non-pooler) URL for migrations and backups.
DATABASE_DIRECT_URL=postgresql://ROLE:PASSWORD@NEON_DIRECT_HOST/DATABASE?sslmode=verify-full
DATABASE_SSL=true
DB_POOL_MAX=10
# Generate EACH secret independently: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
JWT_ISSUER=facility-condition-assessment
JWT_AUDIENCE=fca-client
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Exact number of trusted proxy hops. 0 for local use; usually 1 behind one reverse proxy.
TRUST_PROXY_HOPS=0
# Choose vercel or azure. Blob storage is for files; PostgreSQL stores records.
BLOB_PROVIDER=vercel
# Required for vercel: create a PRIVATE Vercel Blob store and copy its token.
BLOB_READ_WRITE_TOKEN=
# Required only for azure: provision a PRIVATE container. Leave blank for vercel.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=fca-private
# Real SMTP service is required for registration verification, password reset and report email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Facility Condition Assessment <replace-with-your-verified-sender@example.com>
LOG_LEVEL=info
