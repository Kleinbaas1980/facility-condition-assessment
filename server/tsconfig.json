{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "controllers/**/*.ts",
    "routes/**/*.ts",
    "models/**/*.ts",
    "configs/**/*.ts",
    "middleware/**/*.ts",
    "types/**/*.ts",
    "tests/**/*.ts"
  ]
}
